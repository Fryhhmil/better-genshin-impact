<UserControl x:Class="BetterGenshinImpact.View.Controls.MapPointMenu.MapPointMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
             xmlns:viewModel="clr-namespace:BetterGenshinImpact.ViewModel"
             xmlns:converters="clr-namespace:BetterGenshinImpact.View.Converters"
             d:DataContext="{d:DesignInstance Type=viewModel:MaskWindowViewModel}"
             d:DesignWidth="1600"
             d:DesignHeight="900"
             mc:Ignorable="d">
    <!--  大地图点位菜单：左下角圆形按钮、点位面板、右侧已开启栏、临时隐藏提示条。
          DataContext 沿用遮罩窗口的 MaskWindowViewModel；按 1600×900 设计稿排版，整体按 MapMenuScale 缩放  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MapPointMenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ObjectEqualsMultiConverter x:Key="ObjectEqualsMultiConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  临时隐藏提示条：屏幕底部居中，说明标点只是被隐藏  -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Visibility="{Binding AreMapPointsTemporarilyHidden, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding MapMenuScale, Mode=OneWay}" ScaleY="{Binding MapMenuScale, Mode=OneWay}" />
            </Grid.LayoutTransform>
            <Border Margin="0,0,0,28"
                    Padding="14,8,8,8"
                    CornerRadius="22"
                    Style="{StaticResource MapMenu.GlassBorder}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource MapMenu.Gold}"
                                   Symbol="EyeOff24" />
                    <TextBlock Margin="10,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MapMenu.TextPrimary}"
                               Text="{i18n:T 标点已临时隐藏，没有删除任何内容}" />
                    <Button Command="{Binding ToggleMapPointsTemporarilyHiddenCommand}"
                            Content="{i18n:T 显示}"
                            Style="{StaticResource MapMenu.GoldButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  左下角：沿用旧版的比例网格（相对 1920×1080 游戏画面），圆形按钮位于游戏自带设置按钮右侧，不遮挡它  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108*" />
                <ColumnDefinition Width="1802*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*" />
                <RowDefinition Height="1038*" />
                <RowDefinition Height="32*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*" />
                    <ColumnDefinition Width="12*" />
                    <ColumnDefinition Width="640*" />
                    <ColumnDefinition Width="1092*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="328*" />
                    <RowDefinition Height="640*" />
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="58*" />
                </Grid.RowDefinitions>

                <!--  面板与已开启栏：在圆形按钮正上方、左对齐，按 MapMenuScale 缩放；面板收起时已开启栏单独留在按钮上方  -->
                <StackPanel Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding MapMenuScale, Mode=OneWay}" ScaleY="{Binding MapMenuScale, Mode=OneWay}" />
                    </StackPanel.LayoutTransform>

            <!--  ==================== 点位面板 ====================  -->
            <Grid VerticalAlignment="Bottom"
                  Visibility="{Binding IsMapPointPickerOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--  阴影单独一层且不含内容：只在尺寸变化时绘制，避免面板内容每次变化都重新计算阴影效果  -->
            <Border Width="680"
                    Height="540"
                    Background="{StaticResource MapMenu.PanelBackground}"
                    CornerRadius="14"
                    Effect="{StaticResource MapMenu.PanelShadow}"
                    IsHitTestVisible="False" />
            <Border Width="680"
                    Height="540"
                    Style="{StaticResource MapMenu.GlassBorder}">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  ===== 顶栏：数据源、搜索、语言、关闭 =====  -->
                    <Border Grid.Row="0"
                            Padding="10,10,8,10"
                            BorderBrush="{StaticResource MapMenu.Divider}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  数据源：分段按钮，悬停显示完整名称  -->
                            <!--  用按钮而非 ListBox：遮罩窗口无法获得焦点，ListBoxItem 点击时取不到焦点就不会选中  -->
                            <Border Grid.Column="0"
                                    Padding="3"
                                    Background="{StaticResource MapMenu.ControlSurface}"
                                    CornerRadius="10">
                                <ItemsControl ItemsSource="{Binding MapPointApiProviderOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="1,0"
                                                    Command="{Binding DataContext.SelectMapPointApiProviderOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    FocusVisualStyle="{x:Null}"
                                                    ToolTip="{Binding Description, Mode=OneWay}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Seg"
                                                                Height="30"
                                                                Padding="11,0"
                                                                Background="Transparent"
                                                                CornerRadius="7">
                                                            <TextBlock x:Name="SegText"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MapMenu.TextSecondary}"
                                                                       Text="{Binding DisplayName, Mode=OneWay}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Seg" Property="Background" Value="#12FFFFFF" />
                                                                <Setter TargetName="SegText" Property="Foreground" Value="{StaticResource MapMenu.TextPrimary}" />
                                                            </Trigger>
                                                            <!--  当前数据源：浅色底  -->
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource ObjectEqualsMultiConverter}">
                                                                        <Binding Mode="OneWay" />
                                                                        <Binding Mode="OneWay"
                                                                                 Path="DataContext.SelectedMapPointApiProviderOption"
                                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="Seg" Property="Background" Value="{StaticResource MapMenu.Selected}" />
                                                                <Setter TargetName="SegText" Property="Foreground" Value="{StaticResource MapMenu.OnSelected}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!--  搜索框：点击后在上方覆盖真实输入窗口  -->
                            <Border x:Name="SearchBox"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="10,0,4,0"
                                    MouseLeftButtonDown="SearchBox_OnMouseLeftButtonDown"
                                    Style="{StaticResource MapMenu.InputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{StaticResource MapMenu.TextTertiary}"
                                                   Symbol="Search24" />
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding MapLabelSearchText, Mode=OneWay}" />
                                                <Setter Property="Foreground" Value="{StaticResource MapMenu.TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMapLabelSearchActive, Mode=OneWay}" Value="False">
                                                        <Setter Property="Text" Value="{i18n:T 搜索点位类型（例如：水晶）}" />
                                                        <Setter Property="Foreground" Value="{StaticResource MapMenu.TextTertiary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearMapLabelSearchCommand}"
                                            Cursor="Hand"
                                            Style="{StaticResource MapMenu.SmallIconButton}"
                                            ToolTip="{i18n:T 清空搜索}"
                                            Visibility="{Binding IsMapLabelSearchActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!--  HoYoLAB 名称语言  -->
                            <ComboBox Grid.Column="2"
                                      Height="36"
                                      MinWidth="70"
                                      Margin="8,0,0,0"
                                      Padding="10,0,4,0"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding HoYoLabLanguageOptions}"
                                      SelectedItem="{Binding SelectedHoYoLabLanguageOption, Mode=TwoWay}"
                                      ToolTip="{i18n:T 名称语言}"
                                      Visibility="{Binding IsHoYoLabProviderSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Button Grid.Column="3"
                                    Margin="4,0,0,0"
                                    Command="{Binding ToggleMapPointPickerCommand}"
                                    Style="{StaticResource MapMenu.IconButton}"
                                    ToolTip="{i18n:T 关闭面板}">
                                <ui:SymbolIcon FontSize="18" Symbol="Dismiss24" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  ===== HoYoLAB 账号（仅 HoYoLAB 数据源） =====  -->
                    <Border Grid.Row="1"
                            MinHeight="50"
                            Padding="12,8,10,8"
                            BorderBrush="{StaticResource MapMenu.Divider}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding IsHoYoLabProviderSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <!--  未登录：说明 + 登录按钮  -->
                            <Grid Visibility="{Binding ShowHoYoLabLoginButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{StaticResource MapMenu.TextSecondary}"
                                               Symbol="Cloud24" />
                                <TextBlock Grid.Column="1"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{StaticResource MapMenu.TextSecondary}"
                                           Text="{i18n:T 登录后可将已收集的标记与 HoYoLAB 地图同步。}"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="2"
                                        Command="{Binding LoginHoYoLabCommand}"
                                        Content="{i18n:T 登录 HoYoLAB}"
                                        Style="{StaticResource MapMenu.PrimaryButton}" />
                            </Grid>

                            <!--  已登录：头像、名称与同步状态、上传 / 同步 / 退出  -->
                            <Grid Visibility="{Binding ShowHoYoLabAccountPanel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        Background="{StaticResource MapMenu.Gold}"
                                        CornerRadius="15">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MapMenu.OnGold}"
                                               Text="{Binding HoYoLabAvatarText, Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="10,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MapMenu.TextPrimary}"
                                               Text="{Binding HoYoLabNicknameText, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MapMenu.SyncOk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHoYoLabSyncing, Mode=OneWay}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource MapMenu.Gold}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Style="{StaticResource MapMenu.CaptionText}" Text="{Binding HoYoLabSyncStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Margin="0,0,6,0"
                                        Command="{Binding UploadLocalMarksCommand}"
                                        Style="{StaticResource MapMenu.SoftButton}"
                                        ToolTip="{i18n:T 把登录前标记的点位上传到账号}"
                                        Visibility="{Binding HasHoYoLabPendingUploads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0"
                                                       FontSize="15"
                                                       Symbol="CloudArrowUp24" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding HoYoLabUploadButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3"
                                        Margin="0,0,6,0"
                                        Command="{Binding RefreshHoYoLabMarksCommand}"
                                        Style="{StaticResource MapMenu.TextButton}"
                                        ToolTip="{i18n:T 重新读取在手机或网页上做的标记}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  同步中图标旋转  -->
                                        <ui:SymbolIcon Margin="0,0,6,0"
                                                       FontSize="15"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       Symbol="ArrowSync24">
                                            <ui:SymbolIcon.RenderTransform>
                                                <RotateTransform />
                                            </ui:SymbolIcon.RenderTransform>
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHoYoLabSyncing, Mode=OneWay}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SyncSpin">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0"
                                                                                         To="360"
                                                                                         Duration="0:0:0.8" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="SyncSpin" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock VerticalAlignment="Center" Text="{i18n:T 同步}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4"
                                        Command="{Binding LogoutHoYoLabCommand}"
                                        Content="{i18n:T 退出}"
                                        Style="{StaticResource MapMenu.GhostButton}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  ===== 方案 =====  -->
                    <Border Grid.Row="2"
                            MinHeight="48"
                            Padding="12,8,10,8"
                            BorderBrush="{StaticResource MapMenu.Divider}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <!--  方案列表  -->
                            <Grid Visibility="{Binding IsCreatingMapProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MapMenu.CaptionText}"
                                           Text="{i18n:T 方案}" />
                                <ScrollViewer Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="2" Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding MapProfiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ApplyMapProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            FocusVisualStyle="{x:Null}"
                                                            ToolTip="{Binding ToolTip, Mode=OneWay}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Chip"
                                                                        Height="30"
                                                                        Padding="9,0,11,0"
                                                                        Background="#0DFFFFFF"
                                                                        BorderBrush="#1FFFFFFF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="15">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon x:Name="ChipIcon"
                                                                                       Margin="0,0,6,0"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="14"
                                                                                       Foreground="{StaticResource MapMenu.TextPrimary}"
                                                                                       Symbol="Bookmark24" />
                                                                        <TextBlock x:Name="ChipName"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="{StaticResource MapMenu.TextPrimary}"
                                                                                   Text="{Binding Name, Mode=OneWay}" />
                                                                        <TextBlock x:Name="ChipCount"
                                                                                   Margin="6,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource MapMenu.TextTertiary}"
                                                                                   Text="{Binding Count, Mode=OneWay}"
                                                                                   Typography.NumeralAlignment="Tabular" />
                                                                        <!--  已修改提示点  -->
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="6,0,0,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Fill="{StaticResource MapMenu.Modified}"
                                                                                 ToolTip="{i18n:T 应用后已修改}"
                                                                                 Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Chip" Property="Background" Value="#1CFFFFFF" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource MapMenu.Selected}" />
                                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource MapMenu.Selected}" />
                                                                        <Setter TargetName="ChipIcon" Property="Foreground" Value="{StaticResource MapMenu.OnSelected}" />
                                                                        <Setter TargetName="ChipName" Property="Foreground" Value="{StaticResource MapMenu.OnSelected}" />
                                                                        <Setter TargetName="ChipName" Property="FontWeight" Value="SemiBold" />
                                                                        <Setter TargetName="ChipCount" Property="Foreground" Value="#FF5A5F6B" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  新建方案（虚线边框）：没有开启的类型时禁用  -->
                                        <Button Command="{Binding StartCreateMapProfileCommand}"
                                                Cursor="Hand"
                                                FocusVisualStyle="{x:Null}"
                                                ToolTip="{i18n:T 把当前开启的类型保存为方案}"
                                                ToolTipService.ShowOnDisabled="True">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid x:Name="Root" Height="30">
                                                        <Rectangle x:Name="Dash"
                                                                   RadiusX="15"
                                                                   RadiusY="15"
                                                                   Fill="Transparent"
                                                                   Stroke="#33FFFFFF"
                                                                   StrokeDashArray="4 3"
                                                                   StrokeThickness="1" />
                                                        <TextBlock Margin="11,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource MapMenu.TextSecondary}"
                                                                   Text="{i18n:T + 新建方案}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dash" Property="Fill" Value="#12FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <!--  当前方案已修改：还原 / 保存到方案  -->
                                <Button Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Command="{Binding RevertMapProfileCommand}"
                                        Content="{i18n:T 还原}"
                                        Style="{StaticResource MapMenu.GhostButton}"
                                        ToolTip="{i18n:T 回到方案中保存的类型}"
                                        Visibility="{Binding ShowMapProfileDirtyActions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Command="{Binding SaveActiveMapProfileCommand}"
                                        Content="{i18n:T 保存到方案}"
                                        Style="{StaticResource MapMenu.GoldButton}"
                                        ToolTip="{i18n:T 用当前开启的类型覆盖方案}"
                                        Visibility="{Binding ShowMapProfileDirtyActions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!--  当前方案未修改：删除  -->
                                <Button Grid.Column="4"
                                        Margin="6,0,0,0"
                                        Command="{Binding DeleteActiveMapProfileCommand}"
                                        Style="{StaticResource MapMenu.SmallIconButton}"
                                        ToolTip="{Binding MapProfileDeleteToolTip, Mode=OneWay}"
                                        Visibility="{Binding ShowMapProfileDeleteButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:SymbolIcon FontSize="15" Symbol="Delete24" />
                                </Button>
                            </Grid>

                            <!--  新建方案：名称输入  -->
                            <Grid Visibility="{Binding IsCreatingMapProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MapMenu.CaptionText}"
                                           Text="{Binding NewMapProfileHeader, Mode=OneWay}" />
                                <Border x:Name="ProfileNameBox"
                                        Grid.Column="1"
                                        Height="30"
                                        Padding="10,0"
                                        BorderBrush="{StaticResource MapMenu.Accent}"
                                        CornerRadius="8"
                                        MouseLeftButtonDown="ProfileNameBox_OnMouseLeftButtonDown"
                                        Style="{StaticResource MapMenu.InputBorder}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding NewMapProfileName, Mode=OneWay}" />
                                                <Setter Property="Foreground" Value="{StaticResource MapMenu.TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewMapProfileName, Mode=OneWay}" Value="">
                                                        <Setter Property="Text" Value="{i18n:T 名称（例如：稻妻宝箱）}" />
                                                        <Setter Property="Foreground" Value="{StaticResource MapMenu.TextTertiary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Command="{Binding CancelCreateMapProfileCommand}"
                                        Content="{i18n:T 取消}"
                                        Style="{StaticResource MapMenu.GhostButton}" />
                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        Command="{Binding CreateMapProfileCommand}"
                                        Content="{i18n:T 保存方案}"
                                        Style="{StaticResource MapMenu.PrimaryButton}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  ===== 主体：左侧大类 + 右侧类型网格 =====  -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="172" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  大类列表  -->
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource MapMenu.Divider}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="8" ItemsSource="{Binding MapLabelCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,2"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectMapLabelCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    FocusVisualStyle="{x:Null}"
                                                    ToolTip="{Binding Name, Mode=OneWay}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Nav"
                                                                MinHeight="40"
                                                                Padding="8"
                                                                Background="Transparent"
                                                                CornerRadius="9">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!--  大类图标：没有图片时显示强调色圆点  -->
                                                                <Grid Grid.Column="0" Width="22" Height="22">
                                                                    <Ellipse Width="10"
                                                                             Height="10"
                                                                             Fill="{Binding TintBrush, Mode=OneWay}" />
                                                                    <Image Width="22"
                                                                           Height="22"
                                                                           Source="{Binding IconImage, Mode=OneWay}"
                                                                           Stretch="Uniform" />
                                                                </Grid>
                                                                <TextBlock x:Name="NavText"
                                                                           Grid.Column="1"
                                                                           MaxHeight="34"
                                                                           Margin="9,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource MapMenu.TextSecondary}"
                                                                           LineHeight="16"
                                                                           LineStackingStrategy="BlockLineHeight"
                                                                           Text="{Binding Name, Mode=OneWay}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap" />
                                                                <Border Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Style="{StaticResource MapMenu.Badge}"
                                                                        Visibility="{Binding HasSelectedItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding SelectedCount, Mode=OneWay}"
                                                                               Typography.NumeralAlignment="Tabular" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Nav" Property="Background" Value="#0FFFFFFF" />
                                                                <Setter TargetName="NavText" Property="Foreground" Value="{StaticResource MapMenu.TextPrimary}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                                <Setter TargetName="Nav" Property="Background" Value="#21ECE5D8" />
                                                                <Setter TargetName="NavText" Property="Foreground" Value="{StaticResource MapMenu.TextPrimary}" />
                                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!--  类型网格  -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  网格标题与批量开关  -->
                            <Grid Grid.Row="0" Margin="14,12,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MapMenu.HeadingText}" Text="{Binding MapLabelGridTitle, Mode=OneWay}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource MapMenu.CaptionText}"
                                               Text="{Binding MapLabelGridSubtitle, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Command="{Binding EnableAllMapLabelItemsCommand}"
                                        Content="{i18n:T 全部开启}"
                                        Style="{StaticResource MapMenu.TextButton}"
                                        ToolTip="{i18n:T 开启下方列出的全部类型}" />
                                <Button Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Command="{Binding DisableAllMapLabelItemsCommand}"
                                        Content="{i18n:T 全部关闭}"
                                        Style="{StaticResource MapMenu.TextButton}"
                                        ToolTip="{i18n:T 关闭下方列出的全部类型}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Padding="10,0,8,12"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <!--  加载占位  -->
                                    <UniformGrid Columns="2"
                                                 VerticalAlignment="Top"
                                                 Visibility="{Binding IsMapLabelGridLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                        <Border Style="{StaticResource MapMenu.SkeletonCard}" />
                                    </UniformGrid>

                                    <!--  类型卡片  -->
                                    <ItemsControl ItemsSource="{Binding MapLabelItems}"
                                                  Visibility="{Binding IsMapLabelGridLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid VerticalAlignment="Top" Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="4"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectMapLabelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        ToolTip="{Binding Name, Mode=OneWay}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <!--  没有点位的类型不可开启  -->
                                                                <DataTrigger Binding="{Binding IsEmpty, Mode=OneWay}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Card"
                                                                    MinHeight="58"
                                                                    Padding="9,8,12,8"
                                                                    Background="#0AFFFFFF"
                                                                    BorderBrush="#14FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="11">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!--  图标：大类底色 + 官方图标；开启时右下角显示勾  -->
                                                                    <Grid Grid.Column="0"
                                                                          Width="38"
                                                                          Height="38"
                                                                          VerticalAlignment="Center">
                                                                        <Ellipse Fill="{Binding TintBackgroundBrush, Mode=OneWay}" />
                                                                        <Image Width="30"
                                                                               Height="30"
                                                                               Source="{Binding IconImage, Mode=OneWay}"
                                                                               Stretch="Uniform">
                                                                            <Image.Clip>
                                                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                                                            </Image.Clip>
                                                                        </Image>
                                                                        <Border Width="18"
                                                                                Height="18"
                                                                                Margin="0,0,-4,-4"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Bottom"
                                                                                Background="{StaticResource MapMenu.Accent}"
                                                                                BorderBrush="#FF1A1D24"
                                                                                BorderThickness="2"
                                                                                CornerRadius="9"
                                                                                Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <ui:SymbolIcon HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           FontSize="10"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{StaticResource MapMenu.OnAccent}"
                                                                                           Symbol="Checkmark16" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="10,0,6,0"
                                                                                VerticalAlignment="Center">
                                                                        <!--  名称最多两行  -->
                                                                        <TextBlock MaxHeight="33"
                                                                                   FontSize="13"
                                                                                   Foreground="{StaticResource MapMenu.TextPrimary}"
                                                                                   LineHeight="16.5"
                                                                                   LineStackingStrategy="BlockLineHeight"
                                                                                   Text="{Binding Name, Mode=OneWay}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap" />
                                                                        <!--  搜索结果中显示所属大类  -->
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource MapMenu.TextTertiary}"
                                                                                   Text="{Binding CategoryName, Mode=OneWay}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding DataContext.IsMapLabelSearchActive, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>

                                                                    <TextBlock x:Name="CountText"
                                                                               Grid.Column="2"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource MapMenu.TextSecondary}"
                                                                               Text="{Binding PointCountText, Mode=OneWay}"
                                                                               Typography.NumeralAlignment="Tabular" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="Background" Value="#14FFFFFF" />
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#2EFFFFFF" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                                    <Setter TargetName="Card" Property="Background" Value="#2B4AA3FF" />
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource MapMenu.Accent}" />
                                                                    <Setter TargetName="CountText" Property="Foreground" Value="#FFCFE6FF" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Card" Property="Opacity" Value="0.42" />
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  搜索无结果  -->
                                    <StackPanel Margin="12,40"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding ShowMapLabelNoResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource MapMenu.TextSecondary}"
                                                   Text="{Binding MapLabelNoResultsText, Mode=OneWay}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource MapMenu.CaptionText}"
                                                   Text="{i18n:T 换个名称试试，或切换数据源。}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!--  ===== 底栏：可见数量、已收集批量操作 / 全部标记确认 =====  -->
                    <Border Grid.Row="4"
                            MinHeight="54"
                            Padding="14,10,12,10"
                            Background="{StaticResource MapMenu.FooterBackground}"
                            BorderBrush="{StaticResource MapMenu.Divider}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,13,13">
                        <Grid>
                            <Grid Visibility="{Binding IsMarkAllConfirmPending, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            ToolTip="{i18n:T 地图上可见的点位 / 已加载的点位}">
                                    <TextBlock VerticalAlignment="Bottom"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MapMenu.TextPrimary}"
                                               Text="{Binding MapPointVisibleCountText, Mode=OneWay}"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Margin="5,0,0,1"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource MapMenu.CaptionText}"
                                               Text="{Binding MapPointTotalCountText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MapMenu.CaptionText}"
                                           Text="{i18n:T 已收集：}" />
                                <Button Grid.Column="2"
                                        Margin="0,0,6,0"
                                        Command="{Binding AskMarkAllMapPointsCommand}"
                                        Style="{StaticResource MapMenu.TextButton}"
                                        ToolTip="{Binding MarkAllToolTip, Mode=OneWay}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0"
                                                       FontSize="15"
                                                       Symbol="CheckmarkCircle24" />
                                        <TextBlock VerticalAlignment="Center" Text="{i18n:T 全部标记}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3"
                                        Margin="0,0,10,0"
                                        Command="{Binding ShowAllMapPointsCommand}"
                                        Content="{i18n:T 全部取消标记}"
                                        Style="{StaticResource MapMenu.TextButton}"
                                        ToolTip="{Binding MarkAllToolTip, Mode=OneWay}"
                                        ToolTipService.ShowOnDisabled="True" />
                                <CheckBox Grid.Column="4"
                                          VerticalAlignment="Center"
                                          Content="{i18n:T 隐藏已收集}"
                                          IsChecked="{Binding Config.MapMaskConfig.HideMarkedPoints, Mode=TwoWay}"
                                          Style="{StaticResource MapMenu.Switch}"
                                          ToolTip="{i18n:T 已收集的点位从地图上消失，而不是半透明显示}" />
                            </Grid>

                            <!--  全部标记确认（不弹窗，直接在底栏确认）  -->
                            <Grid Visibility="{Binding IsMarkAllConfirmPending, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{StaticResource MapMenu.Gold}"
                                               Symbol="Warning24" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MapMenu.TextPrimary}"
                                               Text="{Binding MarkAllConfirmTitle, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,1,0,0"
                                               Style="{StaticResource MapMenu.CaptionText}"
                                               Text="{Binding MarkAllConfirmSubtitle, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Margin="8,0,6,0"
                                        Command="{Binding CancelMarkAllMapPointsCommand}"
                                        Content="{i18n:T 取消}"
                                        Style="{StaticResource MapMenu.GhostButton}" />
                                <Button Grid.Column="3"
                                        Command="{Binding HideAllMapPointsCommand}"
                                        Content="{i18n:T 全部标记}"
                                        Style="{StaticResource MapMenu.GoldButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!--  ==================== 已开启栏 ====================  -->
            <!--  面板打开时在面板右侧，收起时下移到圆形按钮上方  -->
            <Border Width="60"
                    MaxHeight="540"
                    Padding="0,8"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding ShowSelectedMapLabelRail, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MapMenu.GlassBorder}">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMapPointPickerOpen, Mode=OneWay}" Value="True">
                                <Setter Property="Margin" Value="8,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!--  WPF-UI 的按钮默认左对齐，这里显式居中  -->
                    <Button Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            Command="{Binding ResetSelectedMapLabelSelectionCommand}"
                            Cursor="Hand"
                            DockPanel.Dock="Top"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="{i18n:T 关闭全部类型}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="#12FFFFFF"
                                        CornerRadius="11">
                                    <ui:SymbolIcon x:Name="Icon"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   Foreground="{StaticResource MapMenu.TextPrimary}"
                                                   Symbol="Broom24" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#33E5484D" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="#FFFFB4A6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               DockPanel.Dock="Top"
                               FontSize="11"
                               Foreground="{StaticResource MapMenu.TextTertiary}"
                               Text="{Binding SelectedMapLabelCountText, Mode=OneWay}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Typography.NumeralAlignment="Tabular" />
                    <Border Width="32"
                            Height="1"
                            Margin="0,6"
                            Background="#1AFFFFFF"
                            DockPanel.Dock="Top" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Padding="0,6" ItemsSource="{Binding SelectedMapLabelItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="42"
                                            Height="42"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            Command="{Binding DataContext.SelectMapLabelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            ToolTip="{Binding Name, Mode=OneWay}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border Background="{Binding TintBackgroundBrush, Mode=OneWay}"
                                                            BorderBrush="#BF4AA3FF"
                                                            BorderThickness="2"
                                                            CornerRadius="21">
                                                        <Image Width="30"
                                                               Height="30"
                                                               Source="{Binding IconImage, Mode=OneWay}"
                                                               Stretch="Uniform">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                                            </Image.Clip>
                                                        </Image>
                                                    </Border>
                                                    <!--  悬停时显示红色“移除”圆点  -->
                                                    <Border x:Name="Remove"
                                                            Width="19"
                                                            Height="19"
                                                            Margin="0,-5,-5,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource MapMenu.Remove}"
                                                            BorderBrush="#FF1A1D24"
                                                            BorderThickness="2"
                                                            CornerRadius="10"
                                                            Visibility="Hidden">
                                                        <ui:SymbolIcon HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10"
                                                                       Foreground="White"
                                                                       Symbol="Subtract12" />
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

                </StackPanel>

                <!--  ==================== 圆形按钮（与旧版相同的外观与位置，避开游戏自带的设置按钮） ====================  -->
                <!--  地球：打开 / 关闭点位面板；收起时显示已开启类型数量  -->
                <Viewbox Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Stretch="Uniform">
                    <Grid Width="58" Height="58">
                        <Border BorderBrush="#77FDF5E4"
                                BorderThickness="6"
                                CornerRadius="29">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2" Opacity="0.25" ShadowDepth="0" Color="#8C8C8C" />
                            </Border.Effect>
                            <Button Command="{Binding ToggleMapPointPickerCommand}"
                                    Style="{StaticResource MapMenu.ClassicOrbButton}"
                                    ToolTip="{Binding MapMenuOrbToolTip, Mode=OneWay}">
                                <ui:SymbolIcon FontSize="30" Symbol="GlobeLocation24" />
                            </Button>
                        </Border>
                        <Border Margin="0,-4,-4,0"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource MapMenu.OrbBackground}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Style="{StaticResource MapMenu.Badge}"
                                Visibility="{Binding ShowMapMenuOrbBadge, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedMapLabelCount, Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>
                    </Grid>
                </Viewbox>

                <!--  眼睛：临时隐藏全部标点（不保存），开启时金色  -->
                <Viewbox Grid.Row="3"
                         Grid.Column="2"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Stretch"
                         Stretch="Uniform">
                    <Grid Width="58" Height="58">
                        <Border BorderBrush="#77FDF5E4"
                                BorderThickness="6"
                                CornerRadius="29">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2" Opacity="0.25" ShadowDepth="0" Color="#8C8C8C" />
                            </Border.Effect>
                            <Button Command="{Binding ToggleMapPointsTemporarilyHiddenCommand}"
                                    Style="{StaticResource MapMenu.ClassicOrbButton}"
                                    Tag="{Binding AreMapPointsTemporarilyHidden, Mode=OneWay}"
                                    ToolTip="{Binding MapPointsEyeToolTip, Mode=OneWay}">
                                <ui:SymbolIcon FontSize="30">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Eye24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AreMapPointsTemporarilyHidden, Mode=OneWay}" Value="True">
                                                    <Setter Property="Symbol" Value="EyeOff24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
