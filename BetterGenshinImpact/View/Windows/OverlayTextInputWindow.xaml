<Window x:Class="BetterGenshinImpact.View.Windows.OverlayTextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        Height="36"
        FontFamily="{DynamicResource TextThemeFontFamily}"
        WindowStartupLocation="Manual"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!--  遮罩窗口无法获得键盘焦点：本窗口覆盖在遮罩中绘制的输入框上接收真实输入。
          无边框、不可缩放，外观与点位菜单的输入框一致（聚焦时蓝色边框）  -->
    <Border CornerRadius="10"
            Background="#FF1E2129"
            BorderBrush="#FF4AA3FF"
            BorderThickness="1">
        <Grid Margin="10,0">
            <TextBlock x:Name="PlaceholderText"
                       VerticalAlignment="Center"
                       Foreground="#FF8A8F9C"
                       FontSize="13"
                       IsHitTestVisible="False" />
            <!--  WPF-UI 的默认 TextBox 样式带最小高度和顶部对齐，这里清零以便文字垂直居中  -->
            <TextBox x:Name="InputTextBox"
                     MinHeight="0"
                     Margin="0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#FFECE5D8"
                     CaretBrush="#FFECE5D8"
                     SelectionBrush="#FF4AA3FF"
                     FontSize="13"
                     Padding="0"
                     TextChanged="InputTextBox_OnTextChanged">
                <TextBox.Template>
                    <!--  去掉系统 TextBox 的边框与焦点样式，只保留文本区域  -->
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>
    </Border>
</Window>
